# Copy to .env and fill in. Never commit the real .env (already gitignored).

DB_USER=postgres
DB_PASSWORD=
DB_NAME=database
DB_PORT=5432
DB_CONNECTION_STRING=postgres://${DB_USER}:${DB_PASSWORD}@segla-database:${DB_PORT}/${DB_NAME}

# development locally; production once deployed (see AUTH.md) - this now
# affects real runtime behavior (cookie Secure flag, knex debug logging),
# not just cosmetic dev/prod labeling.
NODE_ENV=development

COIN_GECKO_API_KEY=

# --- Auth (see AUTH.md) ---
AUTH_USERNAME=
# Generate with: cd server && npm run hash-password
AUTH_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A fresh, unique value per environment - never reuse dev's secret in prod.
JWT_SECRET=
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# Backend's own listen port.
PORT=4001
# Baked in at frontend build time, not container start - see
# SERVER_MIGRATION.md.
REACT_APP_API_BASE_URL=http://localhost:4001
